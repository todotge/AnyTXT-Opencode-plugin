# AnyTXT plugin — copy to the project root .env (or ~/.config/opencode/.env
# as global fallback, used only when the project has no .env)
# Read fresh on every tool call; edits apply without restart.
ANYTXT_PORT=9920
# ANYTXT_URL=http://127.0.0.1:9920
ANYTXT_DIR=
ANYTXT_LIMIT=5
ANYTXT_FILTER_EXT=*
ANYTXT_ORDER=0
# Verify matches against raw text and drop index false positives (1 = on)
ANYTXT_VERIFY=1
# Max chars between terms joined by & (proximity filter)
ANYTXT_NEAR=200
# Seconds to wait for the index after anytxt_sync before giving up
ANYTXT_SYNC_TIMEOUT=120
# Ask approval before each tool call (1 = on). Engine-side permission config
# ignores plugin tool names; the plugin raises the ask itself.
ANYTXT_ASK=1
